{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "predev": "npm run resume",
    "prebuild": "npm run resume",
    "resume": "typst compile --root . --font-path resume/fonts --ignore-system-fonts --pdf-standard ua-1 resume/resume.typ public/resume.pdf",
    "resume:private": "typst compile --root . --font-path resume/fonts --ignore-system-fonts --pdf-standard ua-1 --input private=resume/private.json resume/resume.typ resume/Alexander-Phillips-Resume-private.pdf"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "astro": "^7.3.8",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "unified": "^11.0.5",
    "uniorg-extract-keywords": "^1.1.0",
    "uniorg-parse": "^3.2.2",
    "uniorg-rehype": "^2.2.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
