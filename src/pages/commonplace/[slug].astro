---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/Monogram.astro';
import { formatDate } from '../../lib/essays';
import { getCommonplace, type CommonplaceEntry } from '../../lib/commonplace';

export async function getStaticPaths() {
  const entries = await getCommonplace();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CommonplaceEntry };
const { title, subtitle, date, updated, tags, description, book, bookAuthor, bookYear, bookLink } =
  entry.data;
const byline = [bookAuthor && `by ${bookAuthor}`, bookYear && `(${bookYear})`].filter(Boolean).join(' ');
const { Content } = await render(entry);
---

<Base title={title} description={description} type="article">
  <article class="essay">
    <header class="essay-head">
      <p class="label"><a href="/commonplace/">Commonplace</a></p>
      <h1>{title}</h1>
      {subtitle && <p class="essay-subtitle">{subtitle}</p>}
      {
        book && (
          <p class="source-line">
            From <cite>{bookLink ? <a href={bookLink}>{book}</a> : book}</cite>{byline ? ` ${byline}` : ''}
          </p>
        )
      }
      <p class="meta">
        <time datetime={date?.toISOString()}>{formatDate(date)}</time>
        {updated && <> · Revised {formatDate(updated)}</>}
      </p>
    </header>

    <div class="prose commonplace-body">
      <Content />
    </div>

    <footer class="essay-foot">
      <div class="end-mark"><Monogram size="sm" /></div>
      {tags.length > 0 && <p class="tags">Filed under {tags.map((t) => t.replaceAll('_', ' ')).join(', ')}</p>}
      <a class="back-link" href="/commonplace/">The Commonplace Book</a>
    </footer>
  </article>
</Base>
