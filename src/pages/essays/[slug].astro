---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/Monogram.astro';
import Tags from '../../components/Tags.astro';
import { categoryPath, formatDate, getEssays, type Essay } from '../../lib/essays';
import { ogImagePath } from '../../lib/og';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props as { essay: Essay };
const { title, subtitle, date, updated, category, tags, description, type } = essay.data;
const isNote = type === 'note';
const { Content } = await render(essay);
---

<Base title={title} description={description} type="article" image={ogImagePath(essay)}>
  <article class="essay">
    <header class="essay-head">
      {
        (category || isNote) && (
          <p class="label">
            {category && <a href={categoryPath(category)}>{category}</a>}
            {category && isNote && ' · '}
            {isNote && <span class="label-green">Note</span>}
          </p>
        )
      }
      <h1>{title}</h1>
      {subtitle && <p class="essay-subtitle">{subtitle}</p>}
      <p class="meta">
        <time datetime={date?.toISOString()}>{formatDate(date)}</time>
        {updated && <> · Revised {formatDate(updated)}</>}
      </p>
    </header>

    <div class:list={['prose', 'essay-body', { 'note-body': isNote }]}>
      <Content />
    </div>

    <footer class="essay-foot">
      <div class="end-mark"><Monogram size="sm" /></div>
      <Tags tags={tags} />
      <a class="back-link" href="/essays/">All essays</a>
    </footer>
  </article>
</Base>
