---
import { formatDate } from '../lib/essays';
import { postPath, type Post } from '../lib/posts';

interface Props {
  essays: Post[];
  showDescription?: boolean;
  /** Label commonplace entries as such, for lists that mix them with essays. */
  showSection?: boolean;
}
const { essays, showDescription = false, showSection = false } = Astro.props;
const sectionOf = (post: Post) =>
  post.collection === 'commonplace' ? (showSection ? 'Commonplace' : undefined) : post.data.category;
---

<ul class="essay-list">
  {
    essays.map((essay) => (
      <li>
        {essay.data.type === 'note' && <span class="kind-label">Note</span>}
        <a href={postPath(essay)}>{essay.data.title}</a>
        {essay.data.draft && <span class="draft-badge">Draft</span>}
        {showDescription && essay.data.description && <p class="essay-dek">{essay.data.description}</p>}
        <p class="meta">
          {sectionOf(essay) && <>{sectionOf(essay)} · </>}
          <time datetime={essay.data.date?.toISOString()}>{formatDate(essay.data.date, 'month')}</time>
        </p>
      </li>
    ))
  }
</ul>
