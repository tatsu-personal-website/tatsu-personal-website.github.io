---
import type { CommonplaceEntry } from '../lib/commonplace';
import { formatDate, type Essay } from '../lib/essays';

interface Props {
  essays: (Essay | CommonplaceEntry)[];
  showDescription?: boolean;
  /** URL prefix for each entry. */
  base?: string;
}
const { essays, showDescription = false, base = '/essays/' } = Astro.props;
---

<ul class="essay-list">
  {
    essays.map((essay) => (
      <li>
        {essay.data.type === 'note' && <span class="kind-label">Note</span>}
        <a href={`${base}${essay.id}/`}>{essay.data.title}</a>
        {essay.data.draft && <span class="draft-badge">Draft</span>}
        {showDescription && essay.data.description && <p class="essay-dek">{essay.data.description}</p>}
        <p class="meta">
          {essay.data.category && <>{essay.data.category} · </>}
          <time datetime={essay.data.date?.toISOString()}>{formatDate(essay.data.date, 'month')}</time>
        </p>
      </li>
    ))
  }
</ul>
