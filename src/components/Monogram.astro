---
interface Props {
  size?: 'sm' | 'md';
}
const { size = 'md' } = Astro.props;
---

<span class:list={['monogram', `monogram-${size}`]} aria-hidden="true">AP</span>

<style>
  .monogram {
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--ink);
    box-shadow:
      inset 0 0 0 3px var(--paper),
      inset 0 0 0 4px var(--ink);
    font-family: var(--serif);
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink);
  }
  .monogram-md {
    width: 3.1rem;
    height: 3.1rem;
    font-size: 1.2rem;
  }
  .monogram-sm {
    width: 1.9rem;
    height: 1.9rem;
    font-size: 0.75rem;
    box-shadow:
      inset 0 0 0 2px var(--paper),
      inset 0 0 0 3px var(--ink);
  }
</style>
